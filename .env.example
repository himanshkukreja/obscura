# ── Obscura configuration ───────────────────────────────────────────────────
# Copy to .env. The development values below are OBVIOUSLY FAKE placeholders and the
# services refuse to start with them when NODE_ENV=production.
#
# Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
LOG_LEVEL=info

# ── secrets ─────────────────────────────────────────────────────────────────
# Wraps every content key. Losing it makes every asset permanently unreadable -
# which is also precisely what makes deletion final. Back it up accordingly.
OBSCURA_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1ETy1OT1QtVVNFISE=
# Signs playback tokens.
OBSCURA_TOKEN_SEED=ZGV2LW9ubHktdG9rZW4tc2VlZC1ETy1OT1QtVVNFISE=
# Signs integrity manifests and deletion records. Rotating it does not invalidate old
# records; retired public keys stay published so old manifests remain verifiable.
OBSCURA_INTEGRITY_SEED=ZGV2LW9ubHktaW50ZWctc2VlZC1ETy1OT1QtVVNFISE=
OBSCURA_INTEGRITY_KEY_ID=obscura-integrity-dev
# Salts IP / user-agent hashes.
OBSCURA_HASH_SALT=ZGV2LW9ubHktaXAtaGFzaC1zYWx0

# ── services ────────────────────────────────────────────────────────────────
API_PORT=3001
EDGE_PORT=3002
EDGE_PUBLIC_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://obscura:obscura@postgres:5432/obscura
REDIS_URL=redis://redis:6379

# ── storage ─────────────────────────────────────────────────────────────────
# Two buckets on purpose: the CDN's origin identity gets the delivery bucket only and has
# no path to the source. A single-bucket misconfiguration exposes the ORIGINAL file.
S3_ENDPOINT=http://minio:9000
# The endpoint used when SIGNING urls for a browser. Differs from S3_ENDPOINT whenever the
# service reaches storage over a path the client cannot use (Docker network, VPC endpoint).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=obscura
S3_SECRET_ACCESS_KEY=obscura123
S3_FORCE_PATH_STYLE=true
S3_SOURCE_BUCKET=obscura-source
S3_DELIVERY_BUCKET=obscura-delivery

# ── playback ────────────────────────────────────────────────────────────────
PLAYBACK_SESSION_TTL=14400
# Short on purpose: this bounds how long a leaked token or URL stays useful, and therefore
# how long a revoked session can keep fetching segments. The key endpoint always checks
# the database, so key access is cut off immediately regardless.
PLAYBACK_TOKEN_TTL=180
PLAYBACK_HEARTBEAT_INTERVAL=60
# PLAYBACK_MAX_CONCURRENT=2

# proxy     - bytes through the edge service. Correct for local dev and small installs.
# presigned - short-lived signed URLs direct to storage. No CDN needed.
#             NOTE: Cloudflare R2 presigned URLs are NOT served through the CDN cache.
# cdn_signed- stable URLs + edge token validation. Recommended in production; needs
#             CDN_BASE_URL and a per-CDN edge function (see examples/).
DELIVERY_STRATEGY=proxy
DELIVERY_PRESIGN_TTL=600
# CDN_BASE_URL=https://media.example.com

# ── privacy ─────────────────────────────────────────────────────────────────
# none | hashed | raw.  Hashes still answer "same client?" without retaining an identifier.
PRIVACY_STORE_IP=hashed
PRIVACY_STORE_USER_AGENT=hashed
# Filenames leak personal data into a database column and into API responses.
PRIVACY_STORE_ORIGINAL_FILENAME=true

# ── retention ───────────────────────────────────────────────────────────────
# deletion_records is deliberately absent and retained forever: erasing proof-of-erasure
# defeats its own purpose.
RETENTION_SESSIONS_DAYS=90
RETENTION_EVENTS_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_FAILED_JOBS_DAYS=30

# ── media ───────────────────────────────────────────────────────────────────
PACKAGING_SEGMENT_DURATION=4
PACKAGING_CONTAINER=fmp4
MEDIA_MAX_DURATION=21600
WORKER_CONCURRENCY=2

# ── watermark ───────────────────────────────────────────────────────────────
# Overlay only - deterrence, not prevention. Removable via devtools in seconds and absent
# from a file reassembled from segments. Identify the VIEWER, not the asset.
WATERMARK_ENABLED=true
WATERMARK_TEMPLATE={{user.label}} · {{asset.short_id}}
WATERMARK_POSITION=dynamic
WATERMARK_INTERVAL=15
WATERMARK_OPACITY=0.35

# Demo only: lets POST /api/v1/admin/clients mint the first API key.
ALLOW_CLIENT_BOOTSTRAP=true
